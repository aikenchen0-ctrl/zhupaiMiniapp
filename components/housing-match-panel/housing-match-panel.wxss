.housing-match-panel {
  padding: 18rpx 18rpx 0;
  background: #faf6eb;
}

.housing-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 12rpx 8rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 253, 247, 0.94);
  box-shadow: 0 8rpx 20rpx rgba(70, 52, 22, 0.07);
}

.housing-item {
  flex: 1;
  width: 20%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.housing-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
}

.housing-label {
  max-width: 112rpx;
  height: 30rpx;
  margin-top: 8rpx;
  padding: 0 12rpx;
  border: 2rpx solid rgba(178, 148, 96, 0.32);
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #3b3429;
  font-size: 21rpx;
  line-height: 26rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  background: rgba(255, 255, 255, 0.74);
}

.match-card {
  margin-top: 14rpx;
  border: 2rpx solid rgba(220, 207, 176, 0.86);
  border-radius: 20rpx;
  background: #fffdf7;
  overflow: hidden;
  box-shadow: 0 12rpx 28rpx rgba(93, 72, 30, 0.14);
}

.stay-tabs {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 6rpx;
  background: #ebe4d5;
  box-shadow: inset 0 2rpx 7rpx rgba(113, 91, 48, 0.1);
}

.stay-tab {
  position: relative;
  flex: 1;
  height: 52rpx;
  border-radius: 14rpx;
  color: #71695d;
  font-size: 25rpx;
  line-height: 52rpx;
  text-align: center;
}

.stay-tab::after {
  content: '';
  position: absolute;
  right: 0;
  top: 15rpx;
  width: 2rpx;
  height: 22rpx;
  background: rgba(126, 113, 86, 0.22);
}

.stay-tab:last-child::after,
.stay-tab--active::after {
  display: none;
}

.stay-tab--active {
  color: #2b261f;
  font-weight: 800;
  background: linear-gradient(180deg, #ffe681 0%, #ffc20c 100%);
  box-shadow: 0 5rpx 12rpx rgba(201, 149, 0, 0.28);
}

.match-body {
  padding: 18rpx 28rpx 18rpx;
}

.city-row,
.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.city-name {
  color: #2f2a22;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.city-name::after {
  content: '';
  display: inline-block;
  margin-left: 8rpx;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 8rpx solid #8d8372;
  vertical-align: 4rpx;
}

.location-text {
  color: #5d5549;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.location-text::before {
  content: '';
  display: inline-block;
  width: 17rpx;
  height: 17rpx;
  margin-right: 7rpx;
  border: 3rpx solid #8b8172;
  border-radius: 50%;
  box-sizing: border-box;
  vertical-align: -2rpx;
}

.meta-row {
  margin-top: 6rpx;
  color: #6c6252;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.people-text {
  flex: none;
  white-space: nowrap;
}

.search-row {
  display: flex;
  align-items: center;
  height: 58rpx;
  margin-top: 14rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f0eadf;
}

.search-mark {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex: none;
}

.search-mark::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid #bdb3a3;
  border-radius: 50%;
}

.search-mark::after {
  content: '';
  position: absolute;
  right: 6rpx;
  bottom: 7rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #bdb3a3;
  transform: rotate(45deg);
}

.match-input {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  color: #3b3429;
  font-size: 24rpx;
  line-height: 58rpx;
}

.match-input-placeholder {
  color: #b6ad9e;
}

.room-count {
  flex: none;
  width: 92rpx;
  color: #3b3429;
  font-size: 18rpx;
  line-height: 22rpx;
  text-align: center;
}

.room-icon {
  position: relative;
  width: 28rpx;
  height: 22rpx;
  margin: 0 auto 2rpx;
}

.room-icon::before,
.room-icon::after {
  content: '';
  position: absolute;
  top: 1rpx;
  width: 11rpx;
  height: 11rpx;
  border: 3rpx solid #2f2a22;
  border-radius: 50%;
  box-sizing: border-box;
}

.room-icon::before {
  left: 1rpx;
}

.room-icon::after {
  right: 1rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  min-height: 48rpx;
  margin-top: 12rpx;
}

.match-tag {
  max-width: 140rpx;
  height: 34rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  color: #756953;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
  background: #efe3c8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.match-action {
  flex: 1;
  height: 60rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.match-action--outline {
  border: 3rpx solid rgba(226, 191, 93, 0.64);
  color: #8d6720;
  background: #fffdf7;
}

.match-action--solid {
  color: #6d4d00;
  background: linear-gradient(180deg, #ffd765 0%, #ffc11a 100%);
  box-shadow: 0 6rpx 12rpx rgba(203, 145, 0, 0.24);
}
