.quick-actions {
  position: relative;
  padding: 18rpx 18rpx 22rpx;
  transition: transform 280ms ease, opacity 280ms ease;
  background: rgba(255, 252, 245, 0.94);
  box-shadow: 0 12rpx 34rpx rgba(38, 30, 18, 0.08);
}

.quick-actions--compact .match-card {
  margin-top: -2rpx;
}

.quick-actions--compact .service-scroll {
  position: relative;
  z-index: 1;
  height: 42rpx;
  margin-top: 0;
  overflow: hidden;
  pointer-events: none;
}

.quick-actions--compact .service-row {
  transform: translateY(-4rpx);
}

.quick-actions--compact .service-text {
  opacity: 0;
}

.filter-gradient-zone {
  position: relative;
  z-index: 2;
  padding: 0;
  background: transparent;
}

.housing-scroll {
  padding: 16rpx 14rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 20rpx rgba(74, 55, 22, 0.07);
}

.housing-row,
.service-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  align-items: center;
  column-gap: 10rpx;
}

.housing-row {
  min-height: 92rpx;
}

.housing-item,
.service-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.entry-icon {
  width: 46rpx;
  height: 46rpx;
  display: block;
}

.housing-text,
.service-text {
  color: #2b261f;
  font-size: 22rpx;
  line-height: 26rpx;
  white-space: nowrap;
  max-width: 112rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.housing-text {
  min-width: 66rpx;
  height: 28rpx;
  margin-top: 6rpx;
  padding: 0 12rpx;
  border: 2rpx solid rgba(43, 38, 31, 0.24);
  border-radius: 999rpx;
  line-height: 28rpx;
  text-align: center;
  background: rgba(255, 252, 245, 0.74);
}

.match-card {
  position: relative;
  z-index: 3;
  overflow: hidden;
  margin-top: 16rpx;
  border: 2rpx solid rgba(214, 204, 178, 0.72);
  border-radius: 20rpx;
  background: #fffdf7;
  box-shadow: 0 12rpx 30rpx rgba(91, 70, 28, 0.12);
}

.stay-tabs {
  display: flex;
  align-items: center;
  height: 62rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #ebe4d5;
  box-shadow: inset 0 2rpx 6rpx rgba(109, 92, 53, 0.08);
}

.stay-tab {
  position: relative;
  flex: 1;
  height: 50rpx;
  color: #756d60;
  font-size: 24rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 16rpx;
  background: transparent;
}

.stay-tab::after {
  content: '';
  position: absolute;
  right: 0;
  top: 14rpx;
  width: 2rpx;
  height: 22rpx;
  background: rgba(125, 112, 83, 0.18);
}

.stay-tab:last-child::after,
.stay-tab--active::after {
  display: none;
}

.stay-tab--active {
  color: #2b261f;
  font-weight: 700;
  background: linear-gradient(180deg, #ffe59b 0%, #ffc400 100%);
  box-shadow: 0 4rpx 10rpx rgba(204, 150, 0, 0.28);
}

.match-fields {
  padding: 20rpx 30rpx 22rpx;
  color: #665d4e;
  font-size: 22rpx;
  line-height: 34rpx;
}

.field-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.field-row--main {
  align-items: center;
  color: #494235;
  font-size: 25rpx;
  font-weight: 700;
}

.field-row--period {
  margin-top: 12rpx;
  color: #6f6454;
  font-size: 22rpx;
  font-weight: 600;
}

.location-field::before {
  content: '';
  display: inline-block;
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border: 3rpx solid #8c8171;
  border-radius: 50%;
  vertical-align: -2rpx;
  box-sizing: border-box;
}

.field-placeholder--right {
  flex: none;
}

.keyword-field {
  display: flex;
  align-items: center;
  height: 48rpx;
  margin-top: 14rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #f2ead9;
}

.keyword-placeholder {
  flex: 1;
  color: #b4a78f;
  font-size: 21rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.keyword-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex: none;
}

.keyword-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #c9bda5;
  border-radius: 50%;
}

.keyword-icon::after {
  content: '';
  position: absolute;
  right: 4rpx;
  bottom: 5rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #c9bda5;
  transform: rotate(45deg);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 10rpx;
  min-height: 48rpx;
  margin-top: 12rpx;
}

.match-tag {
  max-width: 130rpx;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  color: #776b57;
  font-size: 19rpx;
  line-height: 32rpx;
  background: #efe4c8;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.match-actions {
  position: relative;
  z-index: 4;
  display: flex;
  gap: 14rpx;
  height: 66rpx;
  padding: 0 30rpx 28rpx;
}

.match-action {
  flex: 1;
  height: 58rpx;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
  background: linear-gradient(180deg, #ffc90a 0%, #f2b300 100%);
  box-shadow: 0 5rpx 10rpx rgba(205, 150, 0, 0.22);
}

.match-action--strong {
  color: #ffffff;
}

.service-scroll {
  margin-top: 18rpx;
  padding: 16rpx 14rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 20rpx rgba(74, 55, 22, 0.07);
}

.service-row {
  min-height: 94rpx;
}

.service-entry-icon {
  width: 52rpx;
  height: 52rpx;
}

.service-text {
  margin-top: 8rpx;
  text-align: center;
}
