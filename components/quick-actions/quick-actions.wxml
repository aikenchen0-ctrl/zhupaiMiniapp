<view class="quick-actions {{compact ? 'quick-actions--compact' : ''}}">
  <view class="filter-gradient-zone">
    <view class="housing-scroll">
      <view class="housing-row">
        <view wx:for="{{housingCategories}}" wx:key="text" class="housing-item">
          <image class="entry-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <view class="housing-text">{{item.text}}</view>
        </view>
      </view>
    </view>

    <view class="match-card">
      <view class="stay-tabs">
        <view
          wx:for="{{stayOptions}}"
          wx:key="text"
          class="stay-tab {{currentStayIndex === index ? 'stay-tab--active' : ''}}"
          data-index="{{index}}"
          bindtap="onStayTap"
        >{{item.text}}</view>
      </view>
      <view class="match-fields">
        <view class="field-row field-row--main">
          <view class="field-placeholder">深圳市</view>
          <view class="location-field">当前位置</view>
        </view>
        <view class="field-row field-row--period">
          <view class="field-placeholder">{{activeStay.periodText}}</view>
          <view class="field-placeholder field-placeholder--right">{{activeStay.peopleText}}</view>
        </view>
        <view class="keyword-field">
          <view class="keyword-placeholder">{{activeStay.keywordPlaceholder}}</view>
          <view class="keyword-icon"></view>
        </view>
        <view class="tag-row">
          <view wx:for="{{activeStay.tags}}" wx:key="*this" class="match-tag">{{item}}</view>
        </view>
      </view>
      <view class="match-actions">
        <view class="match-action" bindtap="onFindTap">立即查找</view>
        <view class="match-action match-action--strong" bindtap="onMatchTap">智能匹配</view>
      </view>
    </view>
  </view>

  <view class="service-scroll">
    <view class="service-row">
      <view wx:for="{{services}}" wx:key="text" class="service-item">
        <image class="entry-icon service-entry-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="service-text">{{item.text}}</view>
      </view>
    </view>
  </view>
</view>
