page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #d8ecda;
}

.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  color: #ffffff;
}

.housing-map {
  width: 100%;
  height: 100%;
}

.map-top {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  top: 0;
  z-index: 20;
  box-sizing: border-box;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 78rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 4rpx;
  background: #202124;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.22);
}

.back-button {
  position: relative;
  flex: none;
  width: 50rpx;
  height: 50rpx;
}

.back-button::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 13rpx;
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #d7d7d7;
  border-bottom: 4rpx solid #d7d7d7;
  transform: rotate(45deg);
}

.search-icon {
  position: relative;
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin: 0 12rpx 0 2rpx;
}

.search-icon::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #86888c;
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: 3rpx;
  bottom: 5rpx;
  width: 14rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #86888c;
  transform: rotate(45deg);
}

.map-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  color: #f5f5f5;
  font-size: 27rpx;
}

.map-placeholder {
  color: #b4b5b8;
}

.message-icon {
  position: relative;
  flex: none;
  width: 42rpx;
  height: 42rpx;
  margin-left: 12rpx;
}

.message-icon::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 7rpx;
  width: 28rpx;
  height: 22rpx;
  border: 3rpx solid #d8d8d8;
  border-radius: 5rpx;
}

.message-icon::after {
  content: '';
  position: absolute;
  left: 15rpx;
  bottom: 5rpx;
  width: 12rpx;
  height: 10rpx;
  border-left: 3rpx solid #d8d8d8;
  border-bottom: 3rpx solid #d8d8d8;
  transform: skewX(-18deg);
}

.filter-row {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 8rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 0 0 4rpx 4rpx;
  background: #202124;
}

.filter-item {
  flex: 1;
  color: #d7d7d7;
  font-size: 25rpx;
  line-height: 72rpx;
  text-align: center;
}

.filter-item text {
  margin-left: 8rpx;
  color: #96989d;
  font-size: 20rpx;
}

.district-layer,
.house-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  pointer-events: none;
}

.district-bubble {
  position: absolute;
  width: 112rpx;
  height: 112rpx;
  margin-left: -56rpx;
  margin-top: -56rpx;
  border-radius: 50%;
  background: rgba(31, 113, 225, 0.9);
  box-shadow: 0 8rpx 18rpx rgba(18, 82, 178, 0.28);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.house-tag {
  position: absolute;
  max-width: 148rpx;
  height: 42rpx;
  padding: 0 14rpx;
  margin-left: -48rpx;
  margin-top: -22rpx;
  border-radius: 8rpx;
  background: rgba(31, 113, 225, 0.92);
  box-shadow: 0 7rpx 16rpx rgba(18, 82, 178, 0.24);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: auto;
}

.side-tools {
  position: fixed;
  right: 18rpx;
  top: 238rpx;
  z-index: 21;
  width: 66rpx;
  background: rgba(28, 30, 32, 0.9);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.2);
}

.tool-item {
  position: relative;
  height: 76rpx;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 24rpx;
  text-align: center;
}

.tool-item + .tool-item {
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.tool-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  margin: 9rpx auto 2rpx;
}

.tool-icon--layer {
  border: 3rpx solid #ffffff;
  border-radius: 5rpx;
}

.tool-icon--area {
  border: 3rpx solid #ffffff;
  border-radius: 50%;
}

.tool-icon--heart {
  transform: rotate(-45deg);
}

.tool-icon--heart::before,
.tool-icon--heart::after {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 28rpx;
  border: 3rpx solid #ffffff;
  border-radius: 18rpx 18rpx 0 0;
}

.tool-icon--heart::before {
  left: 8rpx;
  top: -6rpx;
  transform: rotate(45deg);
}

.tool-icon--heart::after {
  left: -5rpx;
  top: 4rpx;
  transform: rotate(135deg);
}

.tool-icon--list::before,
.tool-icon--list::after {
  content: '';
  position: absolute;
  left: 2rpx;
  width: 26rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.tool-icon--list::before {
  top: 8rpx;
  box-shadow: 0 9rpx 0 #ffffff;
}

.tool-icon--list::after {
  top: 26rpx;
}

.locate-button {
  position: fixed;
  right: 22rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 22;
  width: 74rpx;
  height: 74rpx;
  background: rgba(28, 30, 32, 0.92);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 22rpx;
  text-align: center;
}

.locate-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin: 8rpx auto 2rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
}

.locate-icon::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: -8rpx;
  width: 4rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.locate-icon::after {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 10rpx;
  width: 40rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.result-panel {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 24;
  max-height: 42vh;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 34rpx rgba(0, 0, 0, 0.18);
  color: #171717;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  color: #171717;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.panel-subtitle {
  margin-top: 4rpx;
  color: #777777;
  font-size: 22rpx;
}

.panel-close {
  width: 48rpx;
  height: 48rpx;
  color: #333333;
  font-size: 40rpx;
  line-height: 44rpx;
  text-align: center;
}

.house-list {
  max-height: 31vh;
  margin-top: 14rpx;
}

.house-card {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(20, 20, 20, 0.08);
}

.house-cover {
  flex: none;
  width: 92rpx;
  height: 82rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #e8d2a8 0%, #9bbbd4 100%);
}

.house-main {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.house-title {
  color: #171717;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.house-meta {
  margin-top: 3rpx;
  color: #747474;
  font-size: 21rpx;
  line-height: 28rpx;
}

.house-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.house-tags text {
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #eef4ff;
  color: #2870d8;
  font-size: 18rpx;
  line-height: 28rpx;
}

.house-price {
  flex: none;
  margin-left: 12rpx;
  color: #e1a400;
  font-size: 25rpx;
  font-weight: 900;
}

.empty-result {
  padding: 42rpx 0 32rpx;
  color: #777777;
  font-size: 25rpx;
  text-align: center;
}

.toast-message {
  position: fixed;
  left: 80rpx;
  right: 80rpx;
  top: 50%;
  z-index: 60;
  min-height: 70rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(20, 18, 14, 0.82);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 70rpx;
  text-align: center;
}
