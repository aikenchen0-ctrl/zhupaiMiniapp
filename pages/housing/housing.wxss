page {
  min-height: 100vh;
  background: #f7f2e8;
}

.housing-page {
  min-height: 100vh;
  background: #f7f2e8;
  color: #2b261f;
}

.housing-shell {
  min-height: 100vh;
  padding-bottom: 30rpx;
  box-sizing: border-box;
}

.tool-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 18rpx 0;
  padding: 20rpx 8rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 253, 247, 0.98);
  box-shadow: 0 8rpx 20rpx rgba(70, 52, 22, 0.07);
}

.tool-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tool-icon-wrap {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-icon {
  width: 52rpx;
  height: 52rpx;
}

.tool-text {
  margin-top: 7rpx;
  color: #2b261f;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 30rpx;
  white-space: nowrap;
}

.promise-card,
.bonus-card {
  display: flex;
  align-items: center;
  margin: 18rpx 18rpx 0;
  min-height: 72rpx;
  padding: 0 22rpx;
  border: 2rpx solid rgba(180, 161, 118, 0.34);
  border-radius: 14rpx;
  box-sizing: border-box;
  background: rgba(255, 253, 247, 0.98);
  box-shadow: 0 5rpx 16rpx rgba(70, 52, 22, 0.05);
}

.promise-text {
  flex: 1;
  min-width: 0;
  color: #a19787;
  font-size: 26rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.promise-action {
  flex: none;
  color: #8d8170;
  font-size: 24rpx;
  line-height: 34rpx;
}

.promise-arrow {
  flex: none;
  width: 15rpx;
  height: 15rpx;
  margin-left: 10rpx;
  border-right: 3rpx solid #a19787;
  border-top: 3rpx solid #a19787;
  transform: rotate(45deg);
}

.bonus-card {
  min-height: 76rpx;
}

.bonus-icon {
  position: relative;
  flex: none;
  width: 42rpx;
  height: 42rpx;
  margin-right: 14rpx;
  border: 3rpx solid #ff7f8f;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.bonus-icon::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: -5rpx;
  width: 14rpx;
  height: 12rpx;
  border: 3rpx solid #ff7f8f;
  border-bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
}

.bonus-text {
  flex: 1;
  color: #a19787;
  font-size: 27rpx;
  font-weight: 700;
}

.bonus-action {
  flex: none;
  color: #8d8170;
  font-size: 24rpx;
}

.rank-tabs {
  display: flex;
  align-items: center;
  height: 70rpx;
  margin-top: 16rpx;
  padding: 0 18rpx;
  border-bottom: 1rpx solid rgba(120, 105, 72, 0.12);
  background: rgba(255, 253, 247, 0.92);
}

.rank-tab {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8d8d88;
  font-size: 22rpx;
  line-height: 70rpx;
}

.rank-tab--active {
  color: #2b261f;
  font-weight: 900;
}

.rank-tab--active::after {
  content: '';
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 0;
  height: 6rpx;
  border-radius: 999rpx;
  background: #f1d43f;
}

.rank-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}

.feed-preview {
  margin-top: 0;
  background: #ffffff;
}

.preview-window {
  position: relative;
  height: 370rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #fbfaf5 0%, #f1eadb 100%);
}

.curtain {
  position: absolute;
  top: 0;
  width: 160rpx;
  height: 330rpx;
  border: 3rpx solid rgba(180, 170, 148, 0.45);
  border-bottom: 0;
  background: repeating-linear-gradient(100deg, rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0.35) 16rpx, rgba(230, 220, 202, 0.2) 18rpx);
}

.curtain--left {
  left: 44rpx;
  transform: skewX(-8deg);
}

.curtain--right {
  right: 44rpx;
  transform: skewX(8deg);
}

.sofa {
  position: absolute;
  left: 160rpx;
  right: 160rpx;
  bottom: 34rpx;
  height: 90rpx;
  border-radius: 34rpx 34rpx 12rpx 12rpx;
  background: #dcc8a6;
  box-shadow: 0 -28rpx 0 #eadbbf;
}

.plant {
  position: absolute;
  right: 56rpx;
  bottom: 46rpx;
  width: 54rpx;
  height: 80rpx;
  border-radius: 50% 50% 10rpx 10rpx;
  background: #8daa73;
}

.preview-info {
  padding: 22rpx 26rpx 30rpx;
  background: #ffffff;
}

.preview-title {
  color: #2b261f;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.preview-desc {
  margin-top: 8rpx;
  color: #827767;
  font-size: 24rpx;
  line-height: 34rpx;
}

.toast-message {
  position: fixed;
  left: 80rpx;
  right: 80rpx;
  top: 48%;
  z-index: 30;
  min-height: 70rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(20, 18, 14, 0.82);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 70rpx;
  text-align: center;
}
