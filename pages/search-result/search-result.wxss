page {
  height: 100vh;
  background: #ffffff;
}

.result-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  color: #1f1f1f;
}

.result-top {
  flex: none;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.08);
}

.search-row {
  display: flex;
  align-items: center;
  padding: 32rpx 34rpx 18rpx;
  box-sizing: border-box;
}

.back-button {
  position: relative;
  flex: none;
  width: 56rpx;
  height: 64rpx;
  margin-right: 18rpx;
}

.back-button::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 18rpx;
  width: 24rpx;
  height: 24rpx;
  border-left: 5rpx solid #1f1f1f;
  border-bottom: 5rpx solid #1f1f1f;
  transform: rotate(45deg);
}

.search-box {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  padding: 0 18rpx;
  background: #f7f7f7;
  display: flex;
  align-items: center;
}

.search-icon {
  position: relative;
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.search-icon::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid #1f1f1f;
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: 1rpx;
  bottom: 5rpx;
  width: 17rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #1f1f1f;
  transform: rotate(45deg);
}

.result-input {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  color: #1f1f1f;
  font-size: 28rpx;
}

.result-placeholder {
  color: #c9c9c9;
}

.filter-row {
  display: flex;
  align-items: center;
  height: 78rpx;
  padding: 0 34rpx;
}

.filter-main,
.filter-item {
  flex: 1;
  min-width: 0;
  color: #1f1f1f;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 78rpx;
  white-space: nowrap;
}

.filter-item {
  text-align: center;
}

.filter-item--strong {
  text-align: right;
}

.filter-active {
  color: #000000;
}

.filter-main text,
.filter-item text,
.commute-mode text {
  display: inline-block;
  width: 0;
  height: 0;
  margin-left: 7rpx;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 8rpx solid #1f1f1f;
  vertical-align: 4rpx;
}

.filter-active text,
.commute-mode text {
  border-top-color: #1f1f1f;
}

.commute-row {
  display: flex;
  align-items: center;
  height: 74rpx;
  padding: 0 34rpx 16rpx;
}

.commute-mode {
  flex: none;
  width: 116rpx;
  color: #333333;
  font-size: 27rpx;
}

.commute-time {
  flex: none;
  width: 88rpx;
  color: #333333;
  font-size: 27rpx;
  text-align: center;
}

.commute-slider {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.result-list {
  flex: 1;
  min-height: 0;
  background: #ffffff;
}

.filter-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.46);
  opacity: 0;
  transition: opacity 220ms ease;
}

.filter-mask--visible {
  opacity: 1;
}

.filter-panel {
  position: fixed;
  left: 0;
  right: 0;
  top: calc(246rpx + env(safe-area-inset-top));
  z-index: 21;
  max-height: 62vh;
  background: #ffffff;
  color: #1f1f1f;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.08);
  opacity: 0;
  transform: translateY(-22rpx) scaleY(0.96);
  transform-origin: top center;
  transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 200ms ease;
}

.filter-panel--visible {
  opacity: 1;
  transform: translateY(0) scaleY(1);
}

.filter-content {
  height: calc(62vh - 128rpx);
  min-height: 420rpx;
  background: #ffffff;
}

.filter-content--columns,
.filter-content--room {
  display: flex;
}

.filter-content--simple {
  padding: 34rpx 30rpx;
  box-sizing: border-box;
}

.filter-left,
.room-left {
  flex: none;
  width: 166rpx;
  background: #f3f3f3;
}

.left-item {
  height: 104rpx;
  padding-left: 28rpx;
  box-sizing: border-box;
  color: #1f1f1f;
  font-size: 28rpx;
  line-height: 104rpx;
}

.left-item--active {
  background: #ffffff;
  font-weight: 900;
}

.left-item--active::before {
  content: '· ';
}

.filter-middle {
  flex: none;
  width: 260rpx;
  background: #ffffff;
}

.middle-item {
  height: 104rpx;
  padding-left: 30rpx;
  box-sizing: border-box;
  color: #222222;
  font-size: 28rpx;
  line-height: 104rpx;
}

.middle-item--active {
  font-weight: 900;
}

.middle-item--active::before {
  content: '· ';
}

.filter-right {
  flex: 1;
  min-width: 0;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
}

.filter-right--wide {
  padding: 34rpx 42rpx;
}

.right-item,
.sort-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 94rpx;
}

.right-title,
.sort-item text {
  color: #1f1f1f;
  font-size: 29rpx;
  font-weight: 700;
}

.right-subtitle {
  margin-top: 8rpx;
  color: #8a6b4a;
  font-size: 23rpx;
}

.radio {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border: 3rpx solid #d6d6d6;
  border-radius: 50%;
  box-sizing: border-box;
}

.radio--checked {
  position: relative;
  border-color: #1f1f1f;
  background: #1f1f1f;
}

.radio--checked::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 11rpx;
  height: 17rpx;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
}

.commute-card {
  padding: 12rpx 0 24rpx;
}

.commute-card--wide {
  padding: 16rpx 0;
}

.commute-card-title {
  color: #1f1f1f;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.transport-row {
  display: flex;
  gap: 14rpx;
  margin-top: 34rpx;
}

.transport-choice {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  background: #f7f7f7;
  color: #333333;
  font-size: 22rpx;
  line-height: 58rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: clip;
}

.transport-choice--active {
  border: 2rpx solid #a76435;
  box-sizing: border-box;
  color: #a76435;
  font-weight: 800;
  background: #ffffff;
  line-height: 54rpx;
}

.panel-slider {
  margin-top: 44rpx;
}

.panel-add,
.location-pick {
  margin-top: 42rpx;
  color: #1f1f1f;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.room-main {
  flex: 1;
  min-width: 0;
  padding: 34rpx 30rpx 120rpx;
  box-sizing: border-box;
}

.section-title {
  margin-bottom: 22rpx;
  color: #1f1f1f;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.section-title:not(:first-child) {
  margin-top: 38rpx;
}

.option-grid,
.price-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.grid-option,
.price-option {
  height: 78rpx;
  background: #f8f8f8;
  color: #1f1f1f;
  font-size: 27rpx;
  line-height: 78rpx;
  text-align: center;
}

.grid-option--active,
.price-option--active {
  border: 2rpx solid #1f1f1f;
  box-sizing: border-box;
  background: #ffffff;
  font-weight: 900;
  line-height: 74rpx;
}

.rent-title {
  margin-top: 76rpx;
  color: #1f1f1f;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
}

.rent-slider {
  margin: 42rpx 28rpx 0;
}

.rent-scale {
  display: flex;
  justify-content: space-between;
  margin: 6rpx 30rpx 0;
  color: #999999;
  font-size: 25rpx;
}

.level-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.level-card {
  min-height: 116rpx;
  padding: 22rpx 8rpx;
  box-sizing: border-box;
  background: #f3f6fd;
  color: #263356;
  text-align: center;
}

.level-card view {
  font-size: 28rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.level-card text {
  margin-top: 8rpx;
  color: #777777;
  font-size: 21rpx;
  line-height: 28rpx;
}

.level-card--active {
  border: 2rpx solid #263356;
}

.filter-actions {
  display: flex;
  align-items: center;
  height: 128rpx;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  background: #ffffff;
}

.reset-action {
  flex: none;
  width: 86rpx;
  color: #111827;
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: center;
}

.reset-action::before {
  content: '';
  display: block;
  width: 34rpx;
  height: 34rpx;
  margin: 0 auto 2rpx;
  border: 4rpx solid #111827;
  border-top: 0;
  box-sizing: border-box;
}

.view-action {
  flex: 1;
  height: 82rpx;
  margin-left: 30rpx;
  border-radius: 6rpx;
  background: #1f1f1f;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 82rpx;
  text-align: center;
}

.house-card {
  display: flex;
  padding: 32rpx 34rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.cover-wrap {
  flex: none;
  width: 236rpx;
  height: 270rpx;
}

.cover-image {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #e8dbc9 0%, #9fb8a6 100%);
}

.cover-image--1 {
  background: linear-gradient(135deg, #f0d7a4 0%, #ffffff 48%, #7a967e 100%);
}

.cover-image--2 {
  background: linear-gradient(135deg, #f8f8f8 0%, #d6dce9 50%, #f3d254 100%);
}

.cover-image--3 {
  background: linear-gradient(135deg, #d8ecff 0%, #ffffff 52%, #a8c0e8 100%);
}

.cover-image--4 {
  background: linear-gradient(135deg, #e7f0d8 0%, #ffffff 44%, #d1b28a 100%);
}

.brand-badge {
  position: absolute;
  right: 0;
  top: 0;
  padding: 0 10rpx;
  height: 34rpx;
  background: #263356;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.vr-badge {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  width: 50rpx;
  height: 50rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
}

.house-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.house-title {
  color: #1f1f1f;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.rent-badge {
  display: inline-block;
  height: 34rpx;
  margin-right: 10rpx;
  padding: 0 8rpx;
  background: #ffe06a;
  color: #4c3710;
  font-size: 23rpx;
  line-height: 34rpx;
  vertical-align: 3rpx;
}

.house-meta,
.house-location {
  margin-top: 10rpx;
  color: #666666;
  font-size: 25rpx;
  line-height: 32rpx;
}

.house-location::before {
  content: '';
  display: inline-block;
  width: 16rpx;
  height: 22rpx;
  margin-right: 8rpx;
  border-radius: 12rpx 12rpx 12rpx 2rpx;
  background: #8f8f8f;
  transform: rotate(-45deg);
  vertical-align: -2rpx;
}

.house-commute {
  margin-top: 10rpx;
  color: #a76435;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.price-row {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
}

.price-main {
  color: #d22d2d;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.price-unit {
  margin-left: 3rpx;
  color: #c83d3d;
  font-size: 24rpx;
  font-weight: 800;
}

.origin-price {
  margin-left: 10rpx;
  color: #999999;
  font-size: 24rpx;
  text-decoration: line-through;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.tag-row text {
  height: 32rpx;
  padding: 0 8rpx;
  border: 1rpx solid rgba(170, 62, 62, 0.36);
  color: #a94444;
  font-size: 21rpx;
  line-height: 30rpx;
}

.hot-row {
  margin-top: 14rpx;
  color: #b97443;
  font-size: 23rpx;
  line-height: 30rpx;
}

.load-state {
  height: 92rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 92rpx;
  text-align: center;
}

.toast-message {
  position: fixed;
  left: 80rpx;
  right: 80rpx;
  top: 48%;
  z-index: 30;
  min-height: 70rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(20, 18, 14, 0.82);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 70rpx;
  text-align: center;
}
