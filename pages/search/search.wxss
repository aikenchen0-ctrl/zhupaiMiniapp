page {
  min-height: 100vh;
  background: #ffffff;
}

.search-page {
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
  background: #ffffff;
  color: #111111;
}

.search-shell {
  min-height: 100vh;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 36rpx;
  border-radius: 0;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: none;
}

.top-bar {
  position: relative;
  display: flex;
  align-items: center;
  height: 104rpx;
  box-sizing: border-box;
}

.back-button {
  position: relative;
  flex: none;
  width: 58rpx;
  height: 58rpx;
}

.back-button::before {
  content: '';
  position: absolute;
  left: 18rpx;
  top: 13rpx;
  width: 24rpx;
  height: 24rpx;
  border-left: 5rpx solid #4b4b45;
  border-bottom: 5rpx solid #4b4b45;
  transform: rotate(45deg);
}

.page-title {
  flex: none;
  display: flex;
  align-items: center;
  min-width: 0;
  height: 58rpx;
  color: #111111;
  font-size: 30rpx;
  font-weight: 800;
  white-space: nowrap;
}

.page-title text {
  display: block;
  max-width: 190rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  height: 58rpx;
  gap: 16rpx;
}

.map-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  margin-right: 12rpx;
}

.map-icon view {
  position: absolute;
  top: 7rpx;
  width: 14rpx;
  height: 28rpx;
  border: 4rpx solid #111111;
  border-radius: 4rpx;
  transform: skewY(-18deg);
}

.map-icon view:nth-child(1) {
  left: 1rpx;
}

.map-icon view:nth-child(2) {
  left: 14rpx;
  transform: skewY(18deg);
}

.map-icon view:nth-child(3) {
  left: 27rpx;
}

.scan-button {
  flex: none;
  display: flex;
  align-items: center;
  height: 58rpx;
  color: #111111;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.scan-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  margin-right: 10rpx;
}

.scan-icon::before,
.scan-icon::after {
  content: '';
  position: absolute;
  width: 31rpx;
  height: 31rpx;
  border: 4rpx solid #111111;
  border-radius: 6rpx;
}

.scan-icon::before {
  left: 0;
  top: 0;
  border-right: 0;
  border-bottom: 0;
}

.scan-icon::after {
  right: 0;
  bottom: 0;
  border-left: 0;
  border-top: 0;
}

.search-row {
  display: flex;
  align-items: center;
  height: 66rpx;
  padding-left: 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 22rpx rgba(80, 60, 25, 0.1);
}

.search-mark {
  position: relative;
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
}

.search-mark::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #9b9b95;
  border-radius: 50%;
}

.search-mark::after {
  content: '';
  position: absolute;
  right: 3rpx;
  bottom: 5rpx;
  width: 15rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #9b9b95;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  color: #111111;
  font-size: 28rpx;
}

.search-placeholder {
  color: #9f9f99;
}

.search-submit {
  flex: none;
  width: 108rpx;
  height: 58rpx;
  margin-right: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #ffe381 0%, #f8c026 100%);
  color: #111111;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
}

.history-list {
  padding: 18rpx 16rpx 2rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 58rpx;
  color: #111111;
  font-size: 30rpx;
  line-height: 58rpx;
}

.history-remove {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(95, 99, 100, 0.48);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 30rpx;
  text-align: center;
}

.history-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  margin: 12rpx 16rpx 0;
  border: 2rpx solid rgba(97, 102, 100, 0.28);
  border-radius: 22rpx;
  color: #232323;
  font-size: 25rpx;
}

.history-filter-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.filter-arrow {
  margin-left: 10rpx;
  font-size: 28rpx;
  line-height: 28rpx;
}

.filter-arrow--open {
  transform: rotate(180deg);
}

.history-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 14rpx 18rpx 0;
}

.history-chip {
  max-width: 260rpx;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(239, 226, 198, 0.9);
  color: #5f5748;
  font-size: 23rpx;
  line-height: 42rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.match-card {
  margin-top: 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 34rpx rgba(92, 68, 25, 0.13);
  overflow: hidden;
}

.stay-tabs {
  display: flex;
  align-items: center;
  height: 78rpx;
  border-bottom: 1rpx solid rgba(44, 44, 42, 0.08);
}

.stay-tab {
  position: relative;
  flex: 1;
  color: #8d8d88;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 78rpx;
  text-align: center;
}

.stay-tab--active {
  color: #111111;
  font-weight: 900;
}

.stay-tab--active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 48rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #f7cd39;
  transform: translateX(-50%);
}

.match-body {
  padding: 18rpx 28rpx 26rpx;
}

.match-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  border-bottom: 1rpx solid rgba(43, 43, 40, 0.08);
}

.match-line--first {
  min-height: 56rpx;
}

.city-name {
  color: #111111;
  font-size: 29rpx;
  font-weight: 700;
}

.location-action {
  display: flex;
  align-items: center;
  color: #111111;
  font-size: 27rpx;
  font-weight: 700;
}

.location-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin-right: 8rpx;
}

.location-icon::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 2rpx;
  width: 18rpx;
  height: 24rpx;
  border: 4rpx solid #111111;
  border-radius: 18rpx 18rpx 18rpx 4rpx;
  transform: rotate(-45deg);
}

.location-icon::after {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #111111;
}

.area-input {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  color: #111111;
  font-size: 26rpx;
}

.area-placeholder {
  color: #9d9d96;
}

.people-text {
  flex: none;
  margin-left: 16rpx;
  color: #111111;
  font-size: 27rpx;
  font-weight: 700;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 18rpx;
}

.match-tag {
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #eee9df;
  color: #5c584f;
  font-size: 23rpx;
  line-height: 42rpx;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.match-action {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 60rpx;
  text-align: center;
}

.match-action--outline {
  border: 2rpx solid rgba(196, 157, 47, 0.82);
  color: #b58c20;
  background: #ffffff;
}

.match-action--solid {
  color: #111111;
  background: linear-gradient(180deg, #ffdd65 0%, #f8bd20 100%);
}

.rank-tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  padding: 0 18rpx;
}

.rank-tab {
  position: relative;
  flex: 1;
  color: #222222;
  font-size: 29rpx;
  line-height: 92rpx;
  text-align: center;
}

.rank-tab--active {
  color: #d6a100;
  font-weight: 900;
}

.rank-tab--active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 18rpx;
  width: 46rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #f3c82f;
  transform: translateX(-50%);
}

.rank-swiper {
  height: 390rpx;
}

.rank-list {
  height: 390rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  height: 62rpx;
  color: #111111;
}

.rank-index {
  flex: none;
  width: 54rpx;
  color: #777777;
  font-size: 28rpx;
  line-height: 62rpx;
  text-align: center;
}

.rank-index--1,
.rank-index--2,
.rank-index--3 {
  color: #9a7b3d;
  font-weight: 900;
}

.rank-title {
  flex: 1;
  min-width: 0;
  color: #111111;
  font-size: 29rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-heat {
  flex: none;
  width: 112rpx;
  color: #111111;
  font-size: 29rpx;
  text-align: right;
}

.toast-message {
  position: fixed;
  left: 80rpx;
  right: 80rpx;
  top: 48%;
  z-index: 80;
  min-height: 70rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(20, 18, 14, 0.82);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 70rpx;
  text-align: center;
}
