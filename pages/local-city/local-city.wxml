<view class="local-city-page">
  <view class="local-city-shell" style="padding-top: {{statusBarHeight}}px;">
    <view class="search-row">
      <view class="back-button" bindtap="onBackTap"></view>
      <view class="search-box">
        <view class="search-icon"></view>
        <input class="search-input" value="{{searchValue}}" placeholder="搜索全网商品、隐藏优惠" bindinput="onSearchInput" />
      </view>
    </view>

    <view class="category-grid">
      <view
        wx:for="{{categories}}"
        wx:key="name"
        class="category-item"
        data-index="{{index}}"
        bindtap="onCategoryTap"
      >
        <view class="category-icon category-icon--{{item.tone}}">
          <view class="mini-icon mini-icon--{{item.icon}}"></view>
        </view>
        <view class="category-name">{{item.name}}</view>
      </view>
    </view>

    <view class="group-list">
      <view wx:for="{{groups}}" wx:key="title" class="group-card">
        <view class="group-content">
          <view class="group-title">{{item.title}}</view>
          <view class="group-desc">{{item.desc}}</view>
          <view class="group-location">
            <view class="pin-icon"></view>
            <text>{{item.location}}</text>
          </view>
        </view>
        <view class="group-button" data-index="{{index}}" bindtap="onJoinGroup">立即进群</view>
      </view>
    </view>

    <scroll-view class="product-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="product-tab-row">
        <view
          wx:for="{{tabs}}"
          wx:key="*this"
          class="product-tab {{activeTab === index ? 'product-tab--active' : ''}}"
          data-index="{{index}}"
          bindtap="onTabTap"
        >{{item}}</view>
      </view>
    </scroll-view>

    <view class="product-grid">
      <view wx:for="{{products}}" wx:key="id" class="product-card">
        <view class="product-image-wrap {{item.tall ? 'product-image-wrap--tall' : ''}}">
          <image class="product-image" src="{{item.image}}" mode="aspectFill"></image>
          <view wx:if="{{item.live}}" class="live-badge">
            <view class="live-dot"></view>
            <text>直播中</text>
          </view>
        </view>
        <view class="product-body">
          <view class="product-title">{{item.title}}</view>
          <view class="product-desc">{{item.desc}}</view>
          <view class="product-bottom">
            <view class="price-line">
              <text class="price-symbol">¥</text><text class="price-text">{{item.price}}</text>
              <text class="sold-text">{{item.sold}}</text>
            </view>
            <view class="heart {{item.liked ? 'heart--active' : ''}}" data-id="{{item.id}}" bindtap="onLikeTap"></view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>