page {
  min-height: 100vh;
  background: #faf8ff;
}

.local-city-page {
  min-height: 100vh;
  background: #faf8ff;
  color: #131b2e;
  font-family: Manrope, -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

.local-city-shell {
  min-height: 100vh;
  padding: 24rpx 40rpx 44rpx;
}

.search-row {
  display: flex;
  align-items: center;
}

.back-button {
  position: relative;
  width: 0;
  height: 72rpx;
  overflow: hidden;
}

.search-box {
  position: relative;
  flex: 1;
  height: 72rpx;
  border: 2rpx solid #cfc6ab;
  border-radius: 999rpx;
  background: #f2f3ff;
}

.search-icon {
  position: absolute;
  left: 28rpx;
  top: 22rpx;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #7d775f;
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -7rpx;
  width: 16rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #7d775f;
  transform: rotate(45deg);
}

.search-input {
  height: 72rpx;
  padding: 0 28rpx 0 78rpx;
  color: #131b2e;
  font-size: 28rpx;
  line-height: 72rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  row-gap: 26rpx;
  margin-top: 34rpx;
}

.category-item {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
}

.category-icon {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
}

.category-icon--yellow {
  background: #ffde00;
}

.category-icon--blue {
  background: #40c2fd;
}

.category-icon--cyan {
  background: #1bf6ff;
}

.category-icon--soft {
  background: #e2e7ff;
}

.category-name {
  width: 100%;
  margin-top: 12rpx;
  color: #131b2e;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  white-space: nowrap;
}

.mini-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  color: #00668a;
}

.category-icon--yellow .mini-icon {
  color: #716200;
}

.category-icon--blue .mini-icon {
  color: #004d6a;
}

.category-icon--cyan .mini-icon {
  color: #006d71;
}

.mini-icon::before,
.mini-icon::after {
  content: '';
  position: absolute;
  box-sizing: border-box;
}

.mini-icon--taxi::before,
.mini-icon--ship::before {
  left: 4rpx;
  top: 12rpx;
  width: 28rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
}

.mini-icon--taxi::after,
.mini-icon--ship::after {
  left: 9rpx;
  bottom: 2rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 14rpx 0 0 currentColor;
}

.mini-icon--food::before {
  left: 6rpx;
  top: 2rpx;
  width: 4rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: currentColor;
  box-shadow: 8rpx 0 0 currentColor;
}

.mini-icon--food::after {
  right: 6rpx;
  top: 3rpx;
  width: 9rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-right: 0;
  border-radius: 0 0 0 12rpx;
}

.mini-icon--fun::before,
.mini-icon--movie::before {
  left: 4rpx;
  top: 7rpx;
  width: 28rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
}

.mini-icon--fun::after,
.mini-icon--movie::after {
  left: 12rpx;
  top: 13rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 10rpx solid currentColor;
  border-top: 7rpx solid transparent;
  border-bottom: 7rpx solid transparent;
}

.mini-icon--beauty::before,
.mini-icon--child::before {
  left: 7rpx;
  top: 7rpx;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.mini-icon--beauty::after,
.mini-icon--child::after {
  left: 14rpx;
  top: 15rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 8rpx 0 0 currentColor;
}

.mini-icon--gas::before,
.mini-icon--phone::before {
  left: 9rpx;
  top: 3rpx;
  width: 18rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 5rpx;
}

.mini-icon--gas::after,
.mini-icon--phone::after {
  left: 16rpx;
  bottom: 5rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
}

.mini-icon--edu::before,
.mini-icon--recycle::before {
  left: 3rpx;
  top: 9rpx;
  width: 30rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  transform: rotate(-18deg);
}

.mini-icon--edu::after,
.mini-icon--recycle::after {
  left: 14rpx;
  top: 24rpx;
  width: 8rpx;
  height: 8rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
}

.mini-icon--job::before,
.mini-icon--clean::before {
  left: 5rpx;
  top: 10rpx;
  width: 26rpx;
  height: 20rpx;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
}

.mini-icon--job::after,
.mini-icon--clean::after {
  left: 13rpx;
  top: 5rpx;
  width: 10rpx;
  height: 8rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
}

.mini-icon--heart::before {
  left: 5rpx;
  top: 8rpx;
  width: 26rpx;
  height: 24rpx;
  border-left: 5rpx solid currentColor;
  border-bottom: 5rpx solid currentColor;
  transform: rotate(-45deg);
  border-radius: 0 0 0 8rpx;
}

.mini-icon--train::before {
  left: 7rpx;
  top: 4rpx;
  width: 22rpx;
  height: 28rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
}

.mini-icon--train::after {
  left: 11rpx;
  top: 13rpx;
  width: 14rpx;
  height: 5rpx;
  background: currentColor;
  box-shadow: 0 10rpx 0 currentColor;
}

.group-list {
  margin-top: 42rpx;
}

.group-card {
  display: flex;
  align-items: center;
  min-height: 154rpx;
  margin-top: 22rpx;
  padding: 24rpx 24rpx 20rpx;
  border: 2rpx solid #cfc6ab;
  border-radius: 16rpx;
  background: #ffffff;
}

.group-content {
  flex: 1;
  min-width: 0;
}

.group-title {
  color: #131b2e;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.group-desc {
  margin-top: 8rpx;
  color: #4c4732;
  font-size: 22rpx;
  line-height: 32rpx;
}

.group-location {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  color: #00668a;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 24rpx;
}

.pin-icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  margin-right: 5rpx;
  border: 3rpx solid #00668a;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.pin-icon::after {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 5rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #00668a;
}

.group-button {
  flex: none;
  min-width: 120rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #ffde00;
  color: #716200;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.product-tabs {
  width: 100%;
  height: 76rpx;
  margin-top: 42rpx;
  white-space: nowrap;
}

.product-tab-row {
  display: flex;
  align-items: center;
  min-width: max-content;
  height: 76rpx;
}

.product-tab {
  position: relative;
  flex: none;
  margin-right: 46rpx;
  color: #4c4732;
  font-size: 28rpx;
  line-height: 76rpx;
}

.product-tab--active {
  color: #131b2e;
  font-weight: 800;
}

.product-tab--active::after {
  content: '';
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 7rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #ffde00;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.product-card {
  overflow: hidden;
  border: 2rpx solid #cfc6ab;
  border-radius: 16rpx;
  background: #ffffff;
}

.product-image-wrap {
  position: relative;
  height: 280rpx;
  overflow: hidden;
  background: #eaedff;
}

.product-image-wrap--tall {
  height: 360rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

.live-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  display: flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #ef334f;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.live-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 7rpx;
  border-radius: 50%;
  background: #ffffff;
}

.product-body {
  padding: 18rpx 18rpx 16rpx;
}

.product-title {
  color: #131b2e;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-desc {
  display: -webkit-box;
  height: 64rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #4c4732;
  font-size: 21rpx;
  line-height: 32rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.price-line {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.price-symbol,
.price-text {
  color: #6d5e00;
  font-weight: 800;
}

.price-symbol {
  font-size: 22rpx;
}

.price-text {
  font-size: 30rpx;
}

.sold-text {
  margin-left: 8rpx;
  color: #7d775f;
  font-size: 18rpx;
}

.heart {
  position: relative;
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin-left: 8rpx;
}

.heart::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 7rpx;
  width: 20rpx;
  height: 18rpx;
  border-left: 3rpx solid #7d775f;
  border-bottom: 3rpx solid #7d775f;
  transform: rotate(-45deg);
  border-radius: 0 0 0 6rpx;
}

.heart--active::before {
  border-color: #ba1a1a;
  background: #ba1a1a;
}