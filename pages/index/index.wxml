<view class="home-page">
  <view class="top-fixed-area top-fixed-area--light" style="padding-top: {{statusBarHeight}}px; height: calc({{statusBarHeight}}px + 72rpx);">
    <view class="home-header">
      <view class="search-icon" bindtap="onSearchTap"></view>
      <scroll-view class="main-nav-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="main-nav">
          <view
            wx:for="{{mainNavs}}"
            wx:key="key"
            class="main-nav-item {{currentMainNav === index ? 'main-nav-item--active' : ''}}"
            data-index="{{index}}"
            bindtap="onMainNavTap"
          >{{item.name}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <scroll-view
    wx:if="{{currentMainNav === 0}}"
    class="housing-channel"
    style="padding-top: calc({{statusBarHeight}}px + 72rpx);"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
  >
    <housing-match-panel
      housing-categories="{{housingCategories}}"
      stay-options="{{stayOptions}}"
      current-stay-index="{{currentStayIndex}}"
      keyword="{{matchKeyword}}"
      bind:staychange="onStayChange"
      bind:categorytap="onHousingCategoryTap"
      bind:keywordinput="onMatchKeywordInput"
      bind:find="onFindTap"
      bind:match="onMatchTap"
    ></housing-match-panel>

    <view class="housing-tool-section">
      <view wx:for="{{housingTools}}" wx:key="text" class="housing-tool-item" data-type="{{item.type}}" bindtap="onHousingToolTap">
        <image class="housing-tool-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="housing-tool-text">{{item.text}}</view>
      </view>
    </view>

    <view class="housing-card-tip" bindtap="onHousingSloganTap">
      <view class="housing-promise-text">1分钟生成找房，省去1天沟通</view>
      <view class="housing-promise-action">知道</view>
      <view class="housing-promise-arrow"></view>
    </view>

    <view class="housing-bonus-card" bindtap="onHousingBonusTap">
      <view class="housing-bonus-icon"></view>
      <view class="housing-bonus-text">有奖免费住</view>
      <view class="housing-bonus-action">去领奖</view>
    </view>

    <view class="housing-rank-tabs">
      <view
        wx:for="{{housingRankTabs}}"
        wx:key="key"
        class="housing-rank-tab {{currentHousingRankIndex === index ? 'housing-rank-tab--active' : ''}}"
        data-index="{{index}}"
        bindtap="onHousingRankTap"
      >
        <image class="housing-rank-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text>{{item.name}}</text>
      </view>
    </view>

    <view class="housing-video-section">
      <view class="housing-video-list">
        <view wx:for="{{activeHousingFeeds}}" wx:key="id" class="housing-video-card">
          <feed-card
            feed="{{item}}"
            is-active="{{false}}"
            blur-rpx="0"
            show-tools-space="{{false}}"
            bind:like="onLikeFeed"
            bind:comment="onOpenComments"
            bind:progress="onFeedProgress"
          ></feed-card>
          <view class="housing-video-tap-layer" data-index="{{index}}" bindtap="onHousingVideoTap"></view>
          <view class="housing-video-info">
            <view class="housing-video-title">{{item.title}}</view>
            <view class="housing-video-desc">{{item.description}}</view>
            <view class="housing-video-meta">
              <text class="housing-video-price">¥{{item.price}} {{item.rentType}}</text>
              <text class="housing-video-place">{{item.linkText}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="housing-preview-info">
        <view class="housing-preview-title">{{activeHousingRank.title}}</view>
        <view class="housing-preview-desc">{{activeHousingRank.desc}}</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{currentMainNav === 0 && showHousingFullscreen}}" class="housing-fullscreen">
    <swiper
      class="housing-fullscreen-swiper"
      current="{{currentHousingFeedIndex}}"
      vertical
      duration="260"
      easing-function="easeOutCubic"
      bindchange="onHousingFullscreenChange"
    >
      <swiper-item wx:for="{{activeHousingFeeds}}" wx:key="id">
        <view class="feed-page {{currentHousingFeedIndex === index ? 'feed-page--active' : ''}}">
          <feed-card
            feed="{{item}}"
            is-active="{{currentHousingFeedIndex === index && showHousingFullscreen}}"
            blur-rpx="0"
            show-tools-space="{{false}}"
            bind:like="onLikeFeed"
            bind:comment="onOpenComments"
            bind:progress="onFeedProgress"
          ></feed-card>
        </view>
      </swiper-item>
    </swiper>

    <view
      class="housing-fullscreen-back"
      style="top: calc({{statusBarHeight}}px + 16rpx);"
      bindtap="closeHousingFullscreen"
    >‹</view>

    <view class="feed-side-actions housing-fullscreen-actions">
      <view class="side-action side-action--avatar" bindtap="onFollowActiveFeed">
        <view class="side-icon-shell avatar-shell">
          <image class="side-icon side-icon--avatar" src="{{socialIcons.user}}" mode="aspectFit"></image>
          <view class="follow-badge"></view>
        </view>
      </view>
      <view class="side-action" bindtap="onLikeActiveFeed">
        <view class="side-icon-shell">
          <image class="side-icon" src="{{activeFeed.liked ? socialIcons.likeActive : socialIcons.like}}" mode="aspectFit"></image>
          <view class="side-count-badge">{{activeFeed.likeText}}</view>
        </view>
      </view>
      <view class="side-action" bindtap="onOpenActiveComments">
        <view class="side-icon-shell">
          <image class="side-icon" src="{{socialIcons.comment}}" mode="aspectFit"></image>
          <view class="side-count-badge">{{activeFeed.commentText}}</view>
        </view>
      </view>
      <view class="side-action side-action--share">
        <view class="side-icon-shell">
          <image class="side-icon" src="{{socialIcons.share}}" mode="aspectFit"></image>
          <view class="side-count-badge">{{activeFeed.shareText}}</view>
        </view>
        <button class="side-share-button" open-type="share" bindtap="onShareFeed"></button>
      </view>
      <view class="side-action" bindtap="onColorToolTap">
        <view class="side-icon-shell side-icon-shell--plain">
          <image class="side-icon side-icon--color" src="{{socialIcons.color}}" mode="aspectFit"></image>
          <view class="side-count-badge side-count-badge--soft">{{activeFeed.colorCountText}}</view>
        </view>
      </view>
    </view>

    <view class="feed-info-overlay housing-fullscreen-info">
      <view class="author-line">@ {{activeFeed.author}} · {{activeFeed.location}}</view>
      <view class="feed-title">{{activeFeed.title}}</view>
      <view class="feed-desc">{{activeFeed.description}}</view>
      <view class="feed-tags">{{activeFeed.tags}}</view>
      <view class="music-line">
        <text class="music-note">♪</text>
        <view class="music-viewport">
          <text class="music-text {{activeMusicScroll ? 'music-text--scroll' : ''}}">{{activeMusicTitle}}</text>
        </view>
      </view>
      <view class="price-panel">
        <view class="price-line">
          <text class="price-text">¥{{activeFeed.price}} {{activeFeed.rentType}}</text>
          <text class="detail-link">{{activeFeed.linkText}} ></text>
        </view>
      </view>
      <view class="video-progress-row housing-fullscreen-progress">
        <view class="video-progress-track">
          <view class="video-progress-fill" style="width: {{activeFeedProgressPercent}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{currentMainNav === 3}}"
    class="match-tools-area {{showToolsForCurrentFeed ? '' : 'match-tools-area--hidden'}}"
    style="top: calc({{statusBarHeight}}px + 72rpx); transform: translateY(-{{matchToolsOffsetRpx}}rpx);"
    bindtouchstart="onMatchToolsTouchStart"
    catchtouchmove="onMatchToolsTouchMove"
    bindtouchend="onMatchToolsTouchEnd"
    bindtouchcancel="onMatchToolsTouchEnd"
  >
    <housing-match-panel
      housing-categories="{{housingCategories}}"
      stay-options="{{stayOptions}}"
      current-stay-index="{{currentStayIndex}}"
      keyword="{{matchKeyword}}"
      bind:staychange="onStayChange"
      bind:categorytap="onHousingCategoryTap"
      bind:keywordinput="onMatchKeywordInput"
      bind:find="onFindTap"
      bind:match="onMatchTap"
    ></housing-match-panel>

    <view class="service-scroll">
      <view class="service-row">
        <view wx:for="{{services}}" wx:key="text" class="service-item">
          <image class="service-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <view class="service-text">{{item.text}}</view>
        </view>
      </view>
    </view>
  </view>

  <swiper
    wx:if="{{currentMainNav === 3}}"
    class="feed-swiper"
    current="{{currentFeedIndex}}"
    vertical
    disable-touch="{{showToolsForCurrentFeed || feedTouchLocked}}"
    duration="260"
    easing-function="easeOutCubic"
    bindchange="onFeedChange"
    bindtransition="onFeedTransition"
    bindanimationfinish="onFeedAnimationFinish"
    bindtouchstart="onFeedSwipeTouchStart"
    bindtouchmove="onFeedSwipeTouchMove"
    bindtouchend="onFeedSwipeTouchEnd"
    bindtouchcancel="onFeedSwipeTouchEnd"
  >
    <swiper-item wx:for="{{feeds}}" wx:key="id">
      <view class="feed-page {{currentFeedIndex === index ? 'feed-page--active' : ''}}">
        <feed-card
          feed="{{item}}"
          is-active="{{currentFeedIndex === index && (index !== 0 || (matchToolsCollapsed && !showToolsForCurrentFeed))}}"
          blur-rpx="{{transitionBlurIndex === index ? transitionBlurRpx : 0}}"
          show-tools-space="{{false}}"
          bind:like="onLikeFeed"
          bind:comment="onOpenComments"
          bind:progress="onFeedProgress"
        ></feed-card>
      </view>
    </swiper-item>
  </swiper>

  <view
    wx:if="{{currentMainNav === 3 && (showToolsForCurrentFeed || feedTouchLocked)}}"
    class="feed-touch-lock {{showToolsForCurrentFeed ? 'feed-touch-lock--tools-visible' : ''}}"
    catchtouchstart="onFeedLockTouchStart"
    catchtouchmove="onFeedLockTouchMove"
    catchtouchend="onFeedLockTouchEnd"
    catchtouchcancel="onFeedLockTouchEnd"
  ></view>

  <view
    wx:if="{{currentMainNav === 3 && currentFeedIndex === 0 && matchToolsCollapsed && !showToolsForCurrentFeed}}"
    class="tools-restore-zone"
    catchtouchstart="onFeedLockTouchStart"
    catchtouchmove="onFeedLockTouchMove"
    catchtouchend="onFeedLockTouchEnd"
    catchtouchcancel="onFeedLockTouchEnd"
  ></view>

  <view
    wx:if="{{currentMainNav === 3 && !showToolsForCurrentFeed && mealRedPacket.visible}}"
    class="meal-red-packet"
    style="top: calc({{statusBarHeight}}px + 150rpx);"
    bindtap="onMealRedPacketTap"
  >
    <view class="meal-red-packet-title">
      <view>{{mealRedPacket.title}}</view>
      <view>红包</view>
    </view>
    <view class="meal-red-packet-body">
      <view class="meal-red-packet-seal"></view>
    </view>
    <view class="meal-red-packet-time">
      <text
        wx:for="{{mealRedPacket.countdownChars}}"
        wx:key="index"
        class="{{item.className}}"
      >{{item.value}}</text>
    </view>
  </view>

  <view wx:if="{{currentMainNav === 3 && !showToolsForCurrentFeed}}" class="feed-side-actions">
    <view class="side-action side-action--avatar" bindtap="onFollowActiveFeed">
      <view class="side-icon-shell avatar-shell">
        <image class="side-icon side-icon--avatar" src="{{socialIcons.user}}" mode="aspectFit"></image>
        <view class="follow-badge"></view>
      </view>
    </view>
    <view class="side-action" bindtap="onLikeActiveFeed">
      <view class="side-icon-shell">
        <image class="side-icon" src="{{activeFeed.liked ? socialIcons.likeActive : socialIcons.like}}" mode="aspectFit"></image>
        <view class="side-count-badge">{{activeFeed.likeText}}</view>
      </view>
    </view>
    <view class="side-action" bindtap="onOpenActiveComments">
      <view class="side-icon-shell">
        <image class="side-icon" src="{{socialIcons.comment}}" mode="aspectFit"></image>
        <view class="side-count-badge">{{activeFeed.commentText}}</view>
      </view>
    </view>
    <view class="side-action side-action--share">
      <view class="side-icon-shell">
        <image class="side-icon" src="{{socialIcons.share}}" mode="aspectFit"></image>
        <view class="side-count-badge">{{activeFeed.shareText}}</view>
      </view>
      <button class="side-share-button" open-type="share" bindtap="onShareFeed"></button>
    </view>
    <view class="side-action" bindtap="onColorToolTap">
      <view class="side-icon-shell side-icon-shell--plain">
        <image class="side-icon side-icon--color" src="{{socialIcons.color}}" mode="aspectFit"></image>
        <view class="side-count-badge side-count-badge--soft">{{activeFeed.colorCountText}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{currentMainNav === 3 && !showToolsForCurrentFeed}}" class="feed-info-overlay">
    <view class="author-line">@ {{activeFeed.author}} · {{activeFeed.location}}</view>
    <view class="feed-title">{{activeFeed.title}}</view>
    <view class="feed-desc">{{activeFeed.description}}</view>
    <view class="feed-tags">{{activeFeed.tags}}</view>
    <view class="music-line">
      <text class="music-note">♪</text>
      <view class="music-viewport">
        <text class="music-text {{activeMusicScroll ? 'music-text--scroll' : ''}}">{{activeMusicTitle}}</text>
      </view>
    </view>
    <view class="price-panel {{showCollectionEntry ? 'price-panel--with-collection' : ''}}">
      <view class="price-line">
        <text class="price-text">¥{{activeFeed.price}} {{activeFeed.rentType}}</text>
        <text class="detail-link">{{activeFeed.linkText}} ></text>
      </view>
    </view>
    <view class="video-progress-row {{showCollectionEntry ? 'video-progress-row--with-collection' : ''}}">
      <view class="video-progress-track">
        <view class="video-progress-fill" style="width: {{activeFeedProgressPercent}}%;"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{currentMainNav === 3 && showCollectionEntry}}" class="collection-entry" bindtap="openCollectionDrawer">
    <view class="collection-entry-icon">
      <view></view>
      <view></view>
      <view></view>
    </view>
    <view class="collection-entry-text">合集 · {{activeCollection.title}}</view>
    <view class="collection-entry-close" catchtap="hideCollectionEntry">×</view>
  </view>

  <view wx:if="{{toastText}}" class="toast-message">{{toastText}}</view>

  <view wx:if="{{showSearchPanel}}" class="search-mask" bindtap="closeSearchPanel"></view>
  <view wx:if="{{showSearchPanel}}" class="search-panel">
    <view class="search-title">模拟搜索住处</view>
    <input class="search-input" value="{{searchKeyword}}" placeholder="输入城市、房源、地铁、关键词" bindinput="onKeywordInput" focus="{{true}}" />
    <view class="search-result">推荐：深圳市 · 朝南卧室 · 近地铁 · {{stayOptions[currentStayIndex].text}}</view>
    <view class="search-actions">
      <view class="search-cancel" bindtap="closeSearchPanel">取消</view>
      <view class="search-confirm" bindtap="confirmSearch">搜索</view>
    </view>
  </view>

  <view wx:if="{{showCommentDrawer}}" class="comment-mask {{commentDrawerVisible ? 'comment-mask--visible' : ''}}" bindtap="closeCommentDrawer"></view>
  <view wx:if="{{showCommentDrawer}}" class="comment-drawer {{commentDrawerVisible ? 'comment-drawer--visible' : ''}}">
    <view class="comment-top">
      <view class="place-icon"></view>
      <view class="place-info" bindtap="openPlacePanel">
        <view class="place-title">地点 {{activeFeed.location}}</view>
        <view class="place-subtitle">查看地址/用户评价</view>
      </view>
      <view class="comment-close" bindtap="closeCommentDrawer">×</view>
    </view>
    <view class="comment-tabs">
      <view
        wx:for="{{commentTabs}}"
        wx:key="key"
        class="comment-tab {{currentCommentTab === index ? 'comment-tab--active' : ''}}"
        data-index="{{index}}"
        bindtap="onCommentTabTap"
      >{{item.name}}{{item.count ? item.count : ''}}</view>
    </view>
    <scroll-view class="comment-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{activeComments}}" wx:key="id" class="comment-item">
        <image wx:if="{{item.avatar}}" class="comment-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view wx:else class="comment-avatar comment-avatar--text">{{item.userInitial}}</view>
        <view class="comment-main">
          <view class="comment-user">{{item.user}}</view>
          <view class="comment-text">{{item.text}}</view>
          <view class="comment-meta">{{item.timeText}} <text class="comment-reply" data-index="{{index}}" bindtap="replyComment">回复</text></view>
          <view wx:if="{{item.replyText}}" class="comment-replies" data-index="{{index}}" bindtap="replyComment">{{item.replyText}}</view>
        </view>
        <view class="comment-like" data-index="{{index}}" bindtap="toggleCommentLike">
          <view class="comment-heart {{item.liked ? 'comment-heart--active' : ''}}"></view>
          <view class="comment-like-count">{{item.likeCount}}</view>
        </view>
      </view>
    </scroll-view>
    <view class="comment-input-row">
      <input
        class="comment-input"
        value="{{commentDraft}}"
        placeholder="发条有爱评论..."
        confirm-type="send"
        focus="{{commentInputFocus}}"
        adjust-position="{{true}}"
        cursor-spacing="32"
        bindinput="onCommentDraftInput"
        bindfocus="onCommentInputFocus"
        bindblur="onCommentInputBlur"
        bindconfirm="submitComment"
      />
      <image class="comment-tool-icon" src="{{commentToolIcons.at}}" mode="aspectFit"></image>
      <image class="comment-tool-icon" src="{{commentToolIcons.face}}" mode="aspectFit"></image>
      <view class="comment-send" bindtap="submitComment">发布</view>
    </view>
  </view>

  <view wx:if="{{showPlacePanel}}" class="place-mask" bindtap="closePlacePanel"></view>
  <view wx:if="{{showPlacePanel}}" class="place-panel">
    <view class="place-panel-header">
      <view>
        <view class="place-panel-title">{{activeFeed.location}}</view>
        <view class="place-panel-subtitle">地址与用户评价</view>
      </view>
      <view class="place-panel-close" bindtap="closePlacePanel">×</view>
    </view>
    <view class="place-address-row">
      <view class="place-address-icon"></view>
      <view>
        <view class="place-address-title">模拟地址</view>
        <view class="place-address-text">{{placeDetail.address}}</view>
      </view>
    </view>
    <view class="place-score-row">
      <view class="place-score">{{placeDetail.score}}</view>
      <view class="place-score-text">环境 {{placeDetail.environment}} · 交通 {{placeDetail.traffic}} · 真实度 {{placeDetail.reality}}</view>
    </view>
    <view class="place-review-title">用户评价</view>
    <view wx:for="{{placeDetail.reviews}}" wx:key="text" class="place-review-item">
      <view class="place-review-user">{{item.user}}</view>
      <view class="place-review-text">{{item.text}}</view>
    </view>
  </view>

  <view wx:if="{{showCollectionDrawer}}" class="collection-mask" bindtap="closeCollectionDrawer"></view>
  <view wx:if="{{showCollectionDrawer}}" class="collection-drawer">
    <view class="collection-drawer-header">
      <view class="collection-title-wrap">
        <view class="collection-title-icon">
          <view></view>
          <view></view>
          <view></view>
        </view>
        <view class="collection-drawer-title">相关合集</view>
        <view class="collection-drawer-name">{{activeCollection.title}}</view>
      </view>
      <view class="collection-drawer-close" bindtap="closeCollectionDrawer">⌄</view>
    </view>
    <scroll-view class="collection-list" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="collection-track">
        <view wx:for="{{activeCollection.items}}" wx:key="id" class="collection-card">
          <image class="collection-cover" src="{{item.cover}}" mode="aspectFill"></image>
          <view class="collection-card-shade"></view>
          <view class="collection-card-title">{{item.title}}</view>
          <view class="collection-card-meta">
            <text class="collection-like-icon">♡</text>
            <text>{{item.likeText}}</text>
          </view>
          <view class="collection-episode">{{item.episodeText}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{showPublishPanel}}" class="publish-mask" bindtap="closePublishPanel"></view>
  <view wx:if="{{showPublishPanel}}" class="publish-panel">
    <view class="publish-option">
      <view class="publish-option-icon publish-option-icon--album"></view>
      <view class="publish-option-main">
        <view class="publish-option-title">发图集</view>
        <view class="publish-option-desc">多图记录房源</view>
      </view>
    </view>
    <view class="publish-option">
      <view class="publish-option-icon publish-option-icon--video"></view>
      <view class="publish-option-main">
        <view class="publish-option-title">发视频</view>
        <view class="publish-option-desc">上传看房视频</view>
      </view>
    </view>
  </view>

  <view class="bottom-tabbar">
    <view class="tabbar-item tabbar-item--active">首页</view>
    <view class="tabbar-item" bindtap="onCityTabTap">{{cityTabText}}</view>
    <view class="publish-button {{showPublishPanel ? 'publish-button--active' : ''}}" bindtap="togglePublishPanel">
      <view class="publish-ring"></view>
    </view>
    <view class="tabbar-item">消息</view>
    <view class="tabbar-item">我的</view>
  </view>
</view>
