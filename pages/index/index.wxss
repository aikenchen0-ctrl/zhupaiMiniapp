  min-width: 0;
}

.publish-option-title {
  color: #2b261f;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.publish-option-desc {
  margin-top: 4rpx;
  color: #8b8172;
  font-size: 21rpx;
  line-height: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 42;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 0 30rpx;
  box-sizing: border-box;
  border-top: 2rpx solid rgba(74, 55, 22, 0.08);
  background: #fffaf0;
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.tabbar-item {
  width: 112rpx;
  color: #8b8172;
  font-size: 31rpx;
  line-height: 108rpx;
  text-align: center;
}

.tabbar-item--active {
  color: #2b261f;
  font-weight: 700;
}

.publish-button {
  position: relative;
  width: 70rpx;
  height: 70rpx;
  margin-top: 19rpx;
  border-radius: 50%;
  background: #f1da40;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(142, 112, 28, 0.22);
}

.publish-button--active {
  transform: translateY(-2rpx);
}

.publish-ring {
  width: 28rpx;
  height: 28rpx;
  border: 8rpx solid #fffdf7;
  border-radius: 50%;
  background: #f1da40;
}
